#include <iostream>
using namespace std;

bool checkdate(int &day , int &month , int &year);

int main()

{
    int day , month , year;
    bool flag;

    
    cout <<"enter date between 1/1/2000 to 30/12/2014 in format <D M Y> : \n ";
    cin >> day >> month >> year;
    

    cout <<"date entred : " << day << "/" << month << "/" << year << endl;

    
    flag = checkdate(day , month , year);

    if (flag == true)
    {
        cout << "you entred valide date : " << day << "/" << month << "/" << year << endl;
    }

    else
    {
        cout <<"your entred invalide date! \n corrected date is : " << day << "/" << month << "/" << year << endl;
    }
        
    return 0;
}


bool checkdate(int &day , int &month , int &year)
{
    bool flag = true;
    
    if(day > 30) {
        flag = false;
        day = 30;
    }
    if(day < 1) {
        flag = false;
        day = 1;
    }
    
    if(month > 12) {
        flag = false;
        month = 12;
    }
    if(month < 1) {
        flag = false;
        month = 1;
    }
    
    if(year > 2014) {
        flag = false;
        year = 2014;
    }
    if(year < 2000) {
        flag = false;
        year = 2000;
    }
    
    return flag;
}
