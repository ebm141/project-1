#include<iostream>
#include<string>
#include<cstring>
using namespace std;

bool ispalindrome(char str[])
{
    int j = (int)strlen(str) -1;
    
    for (int i=0 ; i <=  strlen( str ) / 2 ; i++ , j--)
    {
        if(str[i] != str[j])
            return  false;
    }
    return true;
}

int main()
{
    char str[100];
    cout <<"enter a string : ";
    cin.getline(str , 100);
    
    if (ispalindrome (str))
        cout <<"entred string is palindrome  " << endl;
    else
        cout <<"entred string is not palindrome  " << endl;
    
    
    return 0 ;
}


